{
  "name": "uon-connect",
  "private": true,
  "version": "0.1.0",
  "description": "UON CONNECT — plataforma corporativa da UON Consulting",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @uon/api & npm run dev --workspace @uon/web; wait",
    "dev:api": "npm run dev --workspace @uon/api",
    "dev:web": "npm run dev --workspace @uon/web",
    "build": "npm run build --workspace @uon/shared && npm run build --workspace @uon/api && npm run build --workspace @uon/web",
    "start": "npm run start --workspace @uon/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspace @uon/shared && npm run test --workspace @uon/api",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate --workspace @uon/api",
    "db:generate": "npm run db:generate --workspace @uon/api",
    "db:seed:base": "npm run db:seed:base --workspace @uon/api",
    "db:seed:demo": "npm run db:seed:demo --workspace @uon/api",
    "bootstrap:founder": "npm run bootstrap:founder --workspace @uon/api",
    "audit:verify": "npm run audit:verify --workspace @uon/api"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "~1.63.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.12"
  }
}
