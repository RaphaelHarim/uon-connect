# ---------------------------------------------------------------
# Modo CONECTADO — o aplicativo fala com o servidor do UON Connect.
# Carregado pelos comandos que usam "--mode servidor".
#
# Para testar entre MÁQUINAS DIFERENTES na rede da UON, troque
# "localhost" pelo IP que o servidor mostra ao iniciar. Exemplo:
#   VITE_API_BASE_URL=http://10.20.4.18:4000
# ---------------------------------------------------------------

VITE_BACKEND=http
VITE_API_BASE_URL=http://localhost:4000
VITE_REALTIME_URL=http://localhost:4000

# Autenticação: 'mock' usa o login por senha da própria API.
# Trocar para 'entra' quando o Microsoft Entra ID for liberado.
VITE_AUTH_PROVIDER=mock

# ---------------------------------------------------------------
# MÓDULOS (compilação de PRODUÇÃO)
#
# Hospedar o servidor na própria máquina fica de fora do aplicativo
# que vai para os colaboradores: se cada estação puder hospedar, os
# chamados abertos ali vão para um banco paralelo que ninguém
# acompanha. Para testar hospedagem, use a compilação de teste
# (npm run dist:teste), que carrega o .env.teste.
# ---------------------------------------------------------------
VITE_FEATURE_HOST_SERVER=false
VITE_FEATURE_CHAT=true

# Somente colaboradores do Brasil
VITE_DIRECTORY_COUNTRY_FILTER=BR
