# ---------------------------------------------------------------
# Modo TESTE — igual ao de produção, mas COM hospedagem local.
# Carregado pelos comandos que usam "--mode servidor".
#
# Para testar entre MÁQUINAS DIFERENTES na rede da UON, troque
# "localhost" pelo IP que o servidor mostra ao iniciar. Exemplo:
#   VITE_API_BASE_URL=http://10.20.4.18:4000
# ---------------------------------------------------------------

VITE_BACKEND=http
VITE_API_BASE_URL=http://localhost:4000
VITE_REALTIME_URL=http://localhost:4000

# Autenticação: 'mock' usa o login por senha da própria API.
# Trocar para 'entra' quando o Microsoft Entra ID for liberado.
VITE_AUTH_PROVIDER=mock

# ---------------------------------------------------------------
# MÓDULOS (compilação de TESTE)
#
# Aqui a hospedagem local existe: é o que permite validar tudo numa
# máquina só, antes de publicar a atualização de verdade.
# ---------------------------------------------------------------
VITE_FEATURE_HOST_SERVER=true
VITE_FEATURE_CHAT=true

# Somente colaboradores do Brasil
VITE_DIRECTORY_COUNTRY_FILTER=BR
