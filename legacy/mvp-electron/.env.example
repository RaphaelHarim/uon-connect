# ---------------------------------------------------------------
# UON Connect — variáveis do aplicativo (cliente)
#
# Este arquivo é apenas referência. Na prática existem dois modos:
#
#   npm run dev            → modo DEMONSTRAÇÃO (dados em memória, sem servidor)
#   npm run dev:servidor   → modo CONECTADO   (lê o arquivo .env.servidor)
#
# Copie para .env somente se quiser sobrescrever os padrões.
# ---------------------------------------------------------------

# Módulo de conversas. Ligado por padrão, a pedido do RH; use "false"
# para esconder Conversas, Contatos e Grupos.
VITE_FEATURE_CHAT=true

# Origem dos dados: "mock" (demonstração) | "http" (servidor)
VITE_BACKEND=mock

# Endereço do servidor no modo conectado
VITE_API_BASE_URL=http://localhost:4000
VITE_REALTIME_URL=http://localhost:4000

# Provedor de autenticação: "mock" (MVP) | "entra" (produção)
VITE_AUTH_PROVIDER=mock

# Microsoft Entra ID (Azure AD)
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_REDIRECT_URI=uonconnect://auth/callback

# Microsoft Graph
VITE_GRAPH_SCOPES=User.Read,User.ReadBasic.All,Presence.Read.All

# Filtro de diretório: somente colaboradores do Brasil
VITE_DIRECTORY_COUNTRY_FILTER=BR
