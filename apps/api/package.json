{
  "name": "@uon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed:base": "tsx --env-file-if-exists=../../.env src/scripts/seed-base.ts",
    "db:seed:demo": "tsx --env-file-if-exists=../../.env src/scripts/seed-demo.ts",
    "bootstrap:founder": "tsx --env-file-if-exists=../../.env src/scripts/bootstrap-founder.ts",
    "audit:verify": "tsx --env-file-if-exists=../../.env src/scripts/verify-audit.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@uon/shared": "*",
    "cookie": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "file-type": "^21.0.0",
    "nodemailer": "^10.2.1",
    "openid-client": "^6.8.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.25.11",
    "pino-pretty": "^13.1.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.6"
  }
}
