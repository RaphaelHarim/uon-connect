# =============================================================================
# UON CONNECT — variáveis de ambiente (exemplo SEM segredos reais)
# Copie para .env (desenvolvimento) ou .env.production (servidor) e preencha.
# Nunca versione arquivos .env preenchidos.
# =============================================================================

# ---- Execução ---------------------------------------------------------------
NODE_ENV=development                 # development | production
HOST=0.0.0.0
PORT=3000
# Endereço público da aplicação. Em produção DEVE ser https://
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=info                       # fatal | error | warn | info | debug
# true quando houver proxy reverso/load balancer na frente (IP real e HTTPS)
TRUST_PROXY=false
# Origens extras permitidas (separadas por vírgula). Vazio = somente a própria origem.
CORS_ORIGINS=

# ---- Banco de dados (PostgreSQL 16) ----------------------------------------
# Em produção use o papel de execução "uon_app" (docker/postgres/app-role.sql),
# e o papel proprietário somente para migrações.
DATABASE_URL=postgres://uon:uon_dev_password@localhost:5432/uon_connect
DATABASE_POOL_MAX=10

# ---- Sessões ----------------------------------------------------------------
SESSION_TTL_HOURS=12                 # duração máxima da sessão
SESSION_IDLE_MINUTES=120             # encerra após inatividade
COOKIE_SECURE=auto                   # auto = seguro em produção
AUTH_RATE_LIMIT_PER_MINUTE=10        # tentativas de login por IP/minuto

# ---- Login de DESENVOLVIMENTO (somente contas fictícias is_demo) -----------
# Ignorado/recusado em produção: o servidor não inicia com isso ligado em NODE_ENV=production.
AUTH_DEV_LOGIN_ENABLED=true
DEV_LOGIN_PASSWORD=troque-esta-senha-de-teste

# ---- Login com usuário e senha (contas locais) -----------------------------
# Sem cadastro aberto: a administração gera um link de convite de uso único por pessoa.
# Exige TOKEN_ENCRYPTION_KEY (cifra os segredos da verificação em duas etapas).
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_ADMIN_MFA_REQUIRED=true   # funções administrativas só valem com 2FA ativa
LOCAL_AUTH_MAX_ATTEMPTS=5            # erros de senha seguidos antes do bloqueio
LOCAL_AUTH_LOCK_MINUTES=15
LOCAL_AUTH_INVITE_TTL_HOURS=72       # validade do link de convite

# ---- Microsoft Entra ID (login corporativo) --------------------------------
# Preenchidos pela TI da UON a partir do registro do aplicativo. Veja docs/INTEGRATIONS.md.
# Ou todos os quatro, ou nenhum.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=                  # ex.: https://connect.suaempresa/api/v1/auth/entra/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=      # ex.: https://connect.suaempresa/login
ENTRA_ALLOWED_EMAIL_DOMAINS=         # ex.: uongroup.com (critério de elegibilidade, nunca de autorização)
ENTRA_ALLOWED_GROUP_IDS=             # IDs (GUID) de grupos autorizados; vazio = qualquer conta do tenant
ENTRA_LINK_BY_EMAIL=true             # associa no 1º login contas pré-cadastradas pelo e-mail
ENTRA_AUTO_PROVISION=false           # cria conta sem vínculos para quem ainda não foi cadastrado

# ---- Microsoft Graph (opcional, exige Entra ID) ----------------------------
GRAPH_CALENDAR_ENABLED=false         # Calendars.Read (delegado)
GRAPH_TEAMS_MEETINGS_ENABLED=false   # OnlineMeetings.ReadWrite (delegado)
# 32 bytes em base64 para cifrar tokens do Graph e segredos de 2FA: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Arquivos ---------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/files    # fora da pasta pública; faça backup
UPLOAD_MAX_FILE_MB=20
UPLOAD_USER_QUOTA_MB=2048
# UPLOAD_ALLOWED_MIME=image/png,image/jpeg,application/pdf,...   (padrão seguro já definido)

# ---- E-mail (SMTP) ------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                           # ex.: UON CONNECT <no-reply@suaempresa>

# ---- Chamadas de vídeo (WebRTC) ------------------------------------------------
WEBRTC_STUN_URLS=                    # ex.: stun:turn.suaempresa:3478
TURN_URLS=                           # ex.: turn:turn.suaempresa:3478?transport=udp,turns:turn.suaempresa:5349
TURN_SECRET=                         # mesmo valor de static-auth-secret do coturn
TURN_TTL_SECONDS=3600
CALL_MAX_PARTICIPANTS=6

# ---- Diversos -----------------------------------------------------------------
# WEB_DIST_DIR=apps/web/dist         # a API serve a interface compilada (produção)
# BRAND_LOGO_URL=/brand/logo-uon.svg # logotipo OFICIAL fornecido pela empresa
JOBS_ENABLED=true
